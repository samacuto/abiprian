---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
---

<header data-pagefind-ignore>
  <Container>
    <div class="flex min-h-16 items-center justify-between gap-3 sm:gap-5">
      <a
        href="/"
        class="font-display text-xl leading-none font-bold tracking-[-0.08em] sm:text-2xl"
      >
        {SITE.TITLE}
        <span class="text-sun">*</span>
      </a>
      <nav
        aria-label="Navegación principal"
        class="flex items-center gap-3 text-[0.6rem] font-bold tracking-[0.1em] uppercase sm:gap-6 sm:text-[0.65rem] sm:tracking-[0.12em]"
      >
        <a class="transition-colors hover:text-clay" href="/#bio">
          Bio
        </a>
        <a class="transition-colors hover:text-clay" href="/#clases">
          Clases
        </a>
        <a
          class="hidden transition-colors hover:text-clay sm:inline"
          href="/#proyectos"
        >
          Proyectos
        </a>
        <a class="transition-colors hover:text-clay" href="/#contacto">
          Contacto
        </a>
      </nav>
    </div>
  </Container>
</header>
