---
import Container from "@components/Container.astro";
import { SOCIALS } from "@consts";
---

<footer>
  <Container>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-display text-base">
        &copy; {new Date().getFullYear()} Abigail Prián
      </p>
      <div class="flex items-center gap-4">
        {SOCIALS.map((social) => (
          <a
            class="font-bold underline decoration-clay decoration-2 underline-offset-4 transition-colors hover:text-clay"
            href={social.HREF}
            target="_blank"
            rel="noreferrer"
          >
            {social.NAME}
          </a>
        ))}
      </div>
    </div>
  </Container>
</footer>
