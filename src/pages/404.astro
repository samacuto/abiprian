---
import Container from "@components/Container.astro";
import Layout from "@layouts/Layout.astro";
import { SITE } from "@consts";
---

<Layout title="Página no encontrada" description={SITE.DESCRIPTION}>
  <Container>
    <section
      class="flex min-h-[calc(100svh-4rem)] items-center py-24"
      aria-labelledby="error-titulo"
    >
      <div>
        <p class="eyebrow text-clay">Error 404</p>
        <h1
          id="error-titulo"
          class="mt-5 font-display text-6xl leading-none tracking-tight sm:text-8xl"
        >
          Esta página
          <br />
          no suena.
        </h1>
        <p class="mt-8 max-w-md text-lg leading-relaxed text-ink/65">
          Puede que la dirección no exista o que se haya movido a otro compás.
        </p>
        <a
          class="mt-10 inline-flex bg-ink px-5 py-3 text-sm font-semibold text-paper transition-colors hover:bg-clay"
          href="/"
        >
          Volver al inicio
        </a>
      </div>
    </section>
  </Container>
</Layout>
