---
import hero from '@assets/abi-hero.webp';
import Container from '@components/Container.astro';
import Layout from '@layouts/Layout.astro';
import { SITE } from '@consts';
---

<Layout
  title="Abigail Prián, violista"
  description={SITE.DESCRIPTION}
  image={hero.src}
>
  <section class="pt-16" aria-labelledby="inicio">
    <Container>
      <div class="grid min-h-[min(48rem,calc(100svh-4rem))] items-end gap-7 py-6 sm:gap-8 sm:py-8 lg:grid-cols-12 lg:gap-12 lg:py-12">
        <div class="fade-in-up order-2 pb-2 lg:order-1 lg:col-span-5 lg:pb-12">
          <p class="eyebrow mb-6 inline-block -rotate-2 bg-sun px-3 py-1 text-ink">
            Violista · Cádiz
          </p>
          <h1
            id="inicio"
            class="font-display text-5xl leading-[0.8] tracking-[-0.07em] min-[380px]:text-6xl sm:text-7xl lg:text-8xl"
          >
            Abigail
            <br />
            Prián
          </h1>
          <p class="mt-8 max-w-sm text-lg leading-relaxed text-ink/70">
            Música, escucha y experimentación desde la viola.
          </p>
          <a
            class="mt-8 inline-flex -rotate-1 bg-clay px-5 py-3 text-sm font-bold text-paper shadow-[5px_5px_0_#2b1b2c] transition-transform hover:rotate-1 hover:shadow-[2px_2px_0_#2b1b2c]"
            href="#contacto"
          >
            Hablemos
          </a>
        </div>
        <figure
          class="fade-in-up relative order-1 p-2 before:absolute before:inset-0 before:-rotate-2 before:bg-clay sm:p-3 lg:order-2 lg:col-span-7"
          style="--animation-delay: 150ms"
        >
          <img
            src={hero.src}
            alt="Abigail tocando la viola en una sala, acompañada por sus sombras proyectadas."
            width={hero.width}
            height={hero.height}
            fetchpriority="high"
            class="relative z-10 h-[45svh] min-h-72 w-full object-cover sepia-[0.15] saturate-125 sm:h-[53svh] sm:min-h-96 lg:h-[min(44rem,calc(100svh-7rem))]"
          />
          <figcaption class="relative z-10 mt-3 -mb-7 ml-4 inline-block rotate-1 bg-paper px-3 py-1 text-xs text-ink/70">
            Archivo personal, 2025
          </figcaption>
        </figure>
      </div>
    </Container>
  </section>

  <section
    id="bio"
    class="border-y border-ink/20 py-16 sm:py-24 lg:py-28"
    aria-labelledby="bio-titulo"
  >
    <Container>
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
        <p class="fade-in-up eyebrow text-clay lg:col-span-3">01 / Bio</p>
        <div
          class="fade-in-up lg:col-span-8 lg:col-start-5"
          style="--animation-delay: 100ms"
        >
          <h2
            id="bio-titulo"
            class="font-display text-4xl leading-[1.05] tracking-[-0.04em] sm:text-5xl"
          >
            Una práctica musical atenta al gesto, al cuerpo y a lo que ocurre
            entre sonidos.
          </h2>
          <p class="mt-8 max-w-2xl text-lg leading-relaxed text-ink/70">
            Abigail Prián es violista. Su trabajo se mueve entre la
            interpretación, la creación colectiva y la pedagogía, entendiendo la
            música como un lugar de encuentro y curiosidad.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <section
    id="clases"
    class="py-16 sm:py-24 lg:py-28"
    aria-labelledby="clases-titulo"
  >
    <Container>
      <div class="relative grid gap-10 lg:grid-cols-12 lg:gap-12">
        <p class="fade-in-up eyebrow text-clay lg:col-span-3">02 / Lessons</p>
        <div class="fade-in-up lg:col-span-9" style="--animation-delay: 100ms">
          <div class="flex flex-col justify-between gap-5 border-b-2 border-ink pb-8 sm:flex-row sm:items-end">
            <h2
              id="clases-titulo"
              class="font-display text-4xl tracking-tight sm:text-5xl"
            >
              Clases de viola
            </h2>
            <p class="max-w-sm text-ink/65">
              Sesiones individuales para todos los niveles, desde el primer
              contacto con el instrumento hasta el trabajo de repertorio.
            </p>
          </div>
          <div class="grid divide-y-2 divide-ink sm:grid-cols-3 sm:divide-x-2 sm:divide-y-0">
            <div class="bg-paper py-7 sm:px-6 sm:first:pl-0">
              <p class="font-semibold">Técnica y sonido</p>
              <p class="mt-2 text-sm leading-relaxed text-ink/65">
                Postura, arco y una escucha propia.
              </p>
            </div>
            <div class="bg-paper py-7 sm:px-6">
              <p class="font-semibold">Repertorio</p>
              <p class="mt-2 text-sm leading-relaxed text-ink/65">
                Acompañamiento para preparar obras y pruebas.
              </p>
            </div>
            <div class="bg-paper py-7 sm:px-6 sm:pr-0">
              <p class="font-semibold">Música de cámara</p>
              <p class="mt-2 text-sm leading-relaxed text-ink/65">
                Herramientas para tocar, comunicar y construir en grupo.
              </p>
            </div>
          </div>
          <a
            class="inline-flex -rotate-1 bg-leaf px-5 py-3 text-sm font-bold text-paper shadow-[5px_5px_0_#2b1b2c] transition-transform hover:rotate-1 hover:bg-clay hover:shadow-[2px_2px_0_#2b1b2c]"
            href={`mailto:${SITE.EMAIL}?subject=Clases%20de%20viola`}
          >
            Consultar clases
          </a>
        </div>
      </div>
    </Container>
  </section>

  <section
    id="proyectos"
    class="relative overflow-hidden bg-ink py-16 text-paper sm:py-24 lg:py-28"
    aria-labelledby="proyectos-titulo"
  >
    <div
      aria-hidden="true"
      class="absolute -top-20 -right-24 size-56 rounded-full border-[2.25rem] border-sun opacity-85 sm:-top-24 sm:-right-16 sm:size-72 sm:border-[3rem]"
    ></div>
    <Container>
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
        <p class="fade-in-up eyebrow text-[#e17a55] lg:col-span-3">
          03 / Projects
        </p>
        <div class="fade-in-up lg:col-span-9" style="--animation-delay: 100ms">
          <h2
            id="proyectos-titulo"
            class="relative z-10 font-display text-4xl tracking-[-0.04em] sm:text-5xl"
          >
            Proyectos en movimiento
          </h2>
          <div class="relative z-10 mt-12 divide-y-2 divide-paper/35 border-t-2 border-paper/35">
            <article class="grid gap-3 py-6 sm:grid-cols-[7rem_1fr]">
              <p class="text-sm text-paper/55">Ensemble</p>
              <div>
                <h3 class="text-xl font-semibold">Música de cámara</h3>
                <p class="mt-2 max-w-xl leading-relaxed text-paper/65">
                  Colaboraciones que atraviesan repertorios, formatos y espacios
                  distintos.
                </p>
              </div>
            </article>
            <article class="grid gap-3 py-6 sm:grid-cols-[7rem_1fr]">
              <p class="text-sm text-paper/55">Escena</p>
              <div>
                <h3 class="text-xl font-semibold">Prácticas situadas</h3>
                <p class="mt-2 max-w-xl leading-relaxed text-paper/65">
                  Propuestas donde sonido, presencia y contexto se afectan
                  mutuamente.
                </p>
              </div>
            </article>
            <article class="grid gap-3 py-6 sm:grid-cols-[7rem_1fr]">
              <p class="text-sm text-paper/55">Pedagogía</p>
              <div>
                <h3 class="text-xl font-semibold">Aprender haciendo</h3>
                <p class="mt-2 max-w-xl leading-relaxed text-paper/65">
                  Talleres y acompañamientos construidos desde la experiencia
                  compartida.
                </p>
              </div>
            </article>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section
    id="archivo"
    class="py-16 sm:py-24 lg:py-28"
    aria-labelledby="archivo-titulo"
  >
    <Container>
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
        <p class="fade-in-up eyebrow text-clay lg:col-span-3">
          04 / Media & Archive
        </p>
        <div class="fade-in-up lg:col-span-9" style="--animation-delay: 100ms">
          <h2
            id="archivo-titulo"
            class="font-display text-4xl tracking-tight sm:text-5xl"
          >
            Archivo en proceso
          </h2>
          <div class="mt-10 grid gap-5 sm:grid-cols-2">
            <div class="rotate-[-1deg] border-2 border-ink bg-sun p-6 shadow-[6px_6px_0_#2b1b2c] sm:p-8">
              <p class="eyebrow text-ink/50">Próximamente</p>
              <p class="mt-12 font-display text-2xl">Escuchas</p>
              <p class="mt-2 text-sm text-ink/65">
                Grabaciones, sesiones y fragmentos.
              </p>
            </div>
            <div class="rotate-[1deg] border-2 border-ink bg-clay p-6 text-paper shadow-[6px_6px_0_#2b1b2c] sm:p-8">
              <p class="eyebrow text-paper/70">Próximamente</p>
              <p class="mt-12 font-display text-2xl">Cuaderno visual</p>
              <p class="mt-2 text-sm text-paper/80">
                Imágenes, partituras y notas de proceso.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section
    id="contacto"
    class="border-t-2 border-ink py-16 sm:py-24 lg:py-28"
    aria-labelledby="contacto-titulo"
  >
    <Container>
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
        <p class="fade-in-up eyebrow text-clay lg:col-span-3">05 / Contact</p>
        <div class="fade-in-up lg:col-span-9" style="--animation-delay: 100ms">
          <h2
            id="contacto-titulo"
            class="max-w-3xl font-display text-5xl leading-[0.85] tracking-[-0.05em] sm:text-6xl"
          >
            ¿Tocamos algo juntas?
          </h2>
          <a
            class="mt-10 inline-block -rotate-1 bg-sun px-4 py-3 text-xl font-bold text-ink shadow-[5px_5px_0_#2b1b2c] transition-transform hover:rotate-1 sm:text-2xl"
            href={`mailto:${SITE.EMAIL}`}
          >
            {SITE.EMAIL}
          </a>
        </div>
      </div>
    </Container>
  </section>

  <script>
    const animatedElements =
      document.querySelectorAll<HTMLElement>('.fade-in-up');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if ('IntersectionObserver' in window && !reduceMotion.matches) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            const element = entry.target as HTMLElement;
            element.classList.remove('will-animate');
            element.classList.add('is-visible');
            observer.unobserve(element);
          });
        },
        { threshold: 0.15 },
      );

      animatedElements.forEach((element) => {
        element.classList.add('will-animate');
        observer.observe(element);
      });
    }
  </script>
</Layout>
